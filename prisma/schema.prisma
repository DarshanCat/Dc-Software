// ============================================================================
// DC & Vendor Material Management — Prisma schema (PostgreSQL)
// All business quantities use Decimal (never Float). Soft-cancel; no hard deletes.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------- AUTH / RBAC ----------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  active       Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  passwordChangedAt  DateTime?
  vendorId     String?
  vendor       Vendor?  @relation(fields: [vendorId], references: [id])
  roles        UserRole[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs    AuditLog[]

  @@index([email])
  @@index([vendorId])
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model RegistrationRequest {
  id                       String             @id @default(uuid())
  fullName                 String
  email                    String
  employeeId               String?
  phone                    String?
  requestedDepartment      String
  reason                   String?
  status                   RegistrationStatus @default(PENDING)
  reviewedAt               DateTime?
  reviewedById             String?
  rejectionReason          String?
  approvingPersonName      String?
  approvedUserId           String?
  activationTokenHash      String?            @unique
  activationTokenExpiresAt DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Role {
  id          String @id @default(uuid())
  key         String @unique
  name        String
  description String?
  isSystem    Boolean @default(false)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ---------------------- MASTERS ----------------------

model Vendor {
  id                String  @id @default(uuid())
  vendorCode        String  @unique
  vendorName        String
  legalName         String?
  gstNumber         String?
  panNumber         String?
  address           String?
  city              String?
  state             String?
  country           String? @default("India")
  pincode           String?
  contactPerson     String?
  phone             String?
  email             String?
  active            Boolean @default(true)
  defaultReturnDays Int     @default(15)
  notes             String?
  contacts          VendorContact[]
  deliveryChallans  DeliveryChallan[]
  workOrders        WorkOrder[]
  users             User[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([vendorCode])
  @@index([active])
}

model VendorContact {
  id        String  @id @default(uuid())
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  phone     String?
  email     String?
  isPrimary Boolean @default(false)

  @@index([vendorId])
}

model UOM {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  isWeight Boolean @default(false)
}

model Process {
  id               String  @id @default(uuid())
  code             String  @unique
  name             String
  active           Boolean @default(true)
  deliveryChallans DeliveryChallan[]
  workOrders       WorkOrder[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}




enum CalculationType {
  FIXED
  PERCENTAGE
  INPUT_MINUS_OUTPUT
  MANUAL
}

model ScrapType {
  id                String  @id @default(uuid())
  code              String  @unique
  name              String
  description       String?
  unit              String  @default("KG")
  active            Boolean @default(true)
  scrapReceiptItems ScrapReceiptItem[]
  classificationItems MaterialClassificationItem[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ---------------------- DELIVERY CHALLAN ----------------------

enum DcStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  DISPATCHED
  AT_VENDOR
  PARTIALLY_RETURNED
  MATERIAL_RETURNED
  SCRAP_PENDING
  RECONCILIATION
  RECONCILED
  CLOSED
  CANCELLED
}

enum DcPurpose {
  JOB_WORK
  MACHINING
  HEAT_TREATMENT
  SURFACE_TREATMENT
  REPAIR
  SAMPLE
  TRIAL
  SUBCONTRACTING
  OTHER
}

model DeliveryChallan {
  id                 String    @id @default(uuid())
  dcNumber           String    @unique
  dcDate             DateTime
  woNumber           String
  partNumber         String?
  rmQuantity         Decimal?  @db.Decimal(12, 3)
  returnFgQuantity   Decimal?  @db.Decimal(12, 3)
  heatNumber         String?
  expectedScrap      Decimal?  @db.Decimal(12, 3)
  vendorId           String
  vendor             Vendor    @relation(fields: [vendorId], references: [id])
  purpose            DcPurpose
  processId          String?
  process            Process?  @relation(fields: [processId], references: [id])
  jobWorkOrderNumber String?
  expectedReturnDate DateTime?
  transporter        String?
  vehicleNumber      String?
  ewayBillNumber     String?
  eSugamNumber       String?
  referenceNumber    String?
  remarks            String?
  status             DcStatus  @default(DRAFT)
  createdBy          String?
  preparedByName     String?
  approvedBy         String?
  approvedByName     String?
  approvedAt         DateTime?
  dispatchedBy       String?
  dispatchedAt       DateTime?
  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?
  qrToken            String?   @unique
  recoveryRequirements RecoveryRequirement[]
  recoveryReceipts   RecoveryReceipt[]
  classifications    MaterialClassification[]
  dispatch           Dispatch?
  receipts           MaterialReceipt[]
  scrapReceipts      ScrapReceipt[]
  reconciliation     Reconciliation?
  exceptions         Exception[]
  amendments         DcAmendment[]
  statusHistory      StatusHistory[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([dcNumber])
  @@index([dcDate])
  @@index([woNumber])
  @@index([vendorId])
  @@index([status])
  @@index([expectedReturnDate])
  @@index([vendorId, status])
}

model DcAmendment {
  id               String    @id @default(uuid())
  dcId             String
  dc               DeliveryChallan @relation(fields: [dcId], references: [id], onDelete: Cascade)
  requestedBy      String
  requestedAt      DateTime  @default(now())
  reason           String
  previousQuantity Decimal   @db.Decimal(18, 3)
  previousWeight   Decimal   @db.Decimal(18, 3)
  newQuantity      Decimal   @db.Decimal(18, 3)
  newWeight        Decimal   @db.Decimal(18, 3)
  status           String    @default("PENDING")
  decidedBy        String?
  decidedAt        DateTime?
  decisionReason   String?

  @@index([dcId])
  @@index([status])
}

// ---------------------- DISPATCH ----------------------

model Dispatch {
  id               String   @id @default(uuid())
  dcId             String   @unique
  dc               DeliveryChallan @relation(fields: [dcId], references: [id])
  dispatchedAt     DateTime
  dispatchedBy     String
  vehicleNumber    String?
  transporter      String?
  totalInputWeight Decimal  @db.Decimal(18, 3)
  items            DispatchItem[]
  createdAt        DateTime @default(now())

  @@index([dcId])
}

model DispatchItem {
  id         String   @id @default(uuid())
  dispatchId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  itemId     String
  quantity   Decimal  @db.Decimal(18, 3)
  weight     Decimal  @db.Decimal(18, 3)

  @@index([dispatchId])
}

// ---------------------- MATERIAL RECEIPT ----------------------

model MaterialReceipt {
  id                String   @id @default(uuid())
  receiptNumber     String   @unique
  receiptDate       DateTime
  dcId              String
  dc                DeliveryChallan @relation(fields: [dcId], references: [id])
  vendorId          String
  receivedBy        String
  remarks           String?
  documentReference String?
  reversedAt        DateTime?
  reversedBy        String?
  reversalReason    String?
  items             MaterialReceiptItem[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([dcId])
  @@index([receiptDate])
}

model MaterialReceiptItem {
  id               String  @id @default(uuid())
  receiptId        String
  receipt          MaterialReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemId           String?
  quantityReceived Decimal @db.Decimal(18, 3)
  weightReceived   Decimal @db.Decimal(18, 3)
  batchNumber      String?
  heatNumber       String?
  rejectedQuantity Decimal @default(0) @db.Decimal(18, 3)
  rejectedWeight   Decimal @default(0) @db.Decimal(18, 3)
  remarks          String?

  @@index([receiptId])
  @@index([itemId])
}

// ---------------------- SCRAP RECEIPT ----------------------

model ScrapReceipt {
  id                  String   @id @default(uuid())
  scrapReceiptNumber  String   @unique
  dcId                String
  dc                  DeliveryChallan @relation(fields: [dcId], references: [id])
  vendorId            String
  receiptDate         DateTime
  receivedBy          String
  weighmentSlipNumber String?
  remarks             String?
  reversedAt          DateTime?
  reversedBy          String?
  reversalReason      String?
  items               ScrapReceiptItem[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([dcId])
  @@index([receiptDate])
}

model ScrapReceiptItem {
  id                String  @id @default(uuid())
  scrapReceiptId    String
  scrapReceipt      ScrapReceipt @relation(fields: [scrapReceiptId], references: [id], onDelete: Cascade)
  scrapTypeId       String
  scrapType         ScrapType @relation(fields: [scrapTypeId], references: [id])
  weight            Decimal @db.Decimal(18, 3)
  quantity          Decimal? @db.Decimal(18, 3)
  uom               String  @default("KG")
  batchReference    String?
  documentReference String?
  remarks           String?

  @@index([scrapReceiptId])
  @@index([scrapTypeId])
}

// ---------------------- RECONCILIATION ----------------------

enum ReconciliationStatus {
  PENDING
  BALANCED
  EXCEPTION
  RECONCILED
  CLOSED
}

model Reconciliation {
  id                   String   @id @default(uuid())
  dcId                 String   @unique
  dc                   DeliveryChallan @relation(fields: [dcId], references: [id])
  status               ReconciliationStatus @default(PENDING)
  totalInputWeight     Decimal  @db.Decimal(18, 3)
  totalFinishedWeight  Decimal  @db.Decimal(18, 3)
  totalScrapWeight     Decimal  @db.Decimal(18, 3)
  totalRejectedWeight  Decimal  @default(0) @db.Decimal(18, 3)
  approvedProcessLoss  Decimal  @db.Decimal(18, 3)
  accountedWeight      Decimal  @db.Decimal(18, 3)
  unaccountedWeight    Decimal  @db.Decimal(18, 3)
  scrapRecoveryPercent Decimal? @db.Decimal(9, 4)
  calculatedAt         DateTime @default(now())
  calculatedBy         String?
  closedAt             DateTime?
  closedBy             String?
  closureReason        String?
  @@index([dcId])
  @@index([status])
}

enum ExceptionType {
  MATERIAL_SHORTAGE
  MATERIAL_RETURN_SHORT
  SCRAP_SHORTAGE
  EXCESS_SCRAP
  BORING_SHORT
  UNCLASSIFIED_MATERIAL
  PROCESS_LOSS_EXCEEDED
  QUANTITY_MISMATCH
  WEIGHT_MISMATCH
  OVERDUE
  OTHER
}

enum ExceptionStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESOLVED
  CLOSED
}

enum ExceptionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Exception {
  id            String   @id @default(uuid())
  dcId          String
  dc            DeliveryChallan @relation(fields: [dcId], references: [id])
  type          ExceptionType
  severity      ExceptionSeverity @default(MEDIUM)
  description   String
  expectedValue Decimal? @db.Decimal(18, 3)
  actualValue   Decimal? @db.Decimal(18, 3)
  variance      Decimal? @db.Decimal(18, 3)
  status        ExceptionStatus @default(OPEN)
  createdBy     String?
  assignedTo    String?
  resolution    String?
  resolvedBy    String?
  resolvedAt    DateTime?
  approvals     ExceptionApproval[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([dcId])
  @@index([status])
  @@index([type])
}

model ExceptionApproval {
  id          String    @id @default(uuid())
  exceptionId String
  exception   Exception @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  approvedBy  String
  reason      String
  approved    Boolean
  documentId  String?
  createdAt   DateTime  @default(now())

  @@index([exceptionId])
}

// ---------------------- DOCUMENTS ----------------------

model Document {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  fileName   String
  fileType   String
  fileSize   Int
  storageKey String
  uploadedBy String?
  uploadedAt DateTime @default(now())

  @@index([entityType, entityId])
}

// ---------------------- NOTIFICATIONS ----------------------

model Notification {
  id         String   @id @default(uuid())
  userId     String?
  type       String
  title      String
  body       String?
  entityType String?
  entityId   String?
  targetUrl  String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

// ---------------------- AUDIT & HISTORY ----------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  module     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  reason     String?
  requestId  String?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
}

model StatusHistory {
  id         String   @id @default(uuid())
  dcId       String
  dc         DeliveryChallan @relation(fields: [dcId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  changedBy  String?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([dcId])
}

// ---------------------- SETTINGS & NUMBERING ----------------------

model SystemSetting {
  id        String @id @default(uuid())
  key       String @unique
  value     String
  group     String @default("general")
  updatedAt DateTime @updatedAt
}

model NumberSequence {
  id         String @id @default(uuid())
  key        String
  fiscalYear String
  prefix     String
  padding    Int    @default(6)
  current    Int    @default(0)

  @@unique([key, fiscalYear])
}

// ============================================================================
// WORK ORDER LAYER (new) — every DC belongs to a WO. WO status is
// transaction-driven (sent vs required, returned vs expected).
// ============================================================================

enum WoStatus {
  DRAFT
  OPEN
  WAITING_FOR_MATERIAL
  READY_FOR_PROCESSING
  PROCESSING
  PARTIALLY_RETURNED
  FULLY_RETURNED
  RECONCILIATION
  CLOSED
  CANCELLED
}

model WorkOrder {
  id                String   @id @default(uuid())
  woNumber          String   @unique
  vendorId          String
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  processId         String?
  process           Process? @relation(fields: [processId], references: [id])
  requiredInputQty  Decimal  @db.Decimal(18, 3)
  requiredInputUOM  String   @default("NOS")
  expectedOutputQty Decimal  @db.Decimal(18, 3)
  expectedOutputUOM String   @default("NOS")
  status            WoStatus @default(OPEN)
  remarks           String?
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([woNumber])
  @@index([vendorId])
  @@index([status])
}




// ============================================================================
// RECOVERY MATERIAL (Boring first; generic so more types can be added later)
// ============================================================================

model RecoveryType {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  unit   String  @default("KG")
  active Boolean @default(true)

  requirements RecoveryRequirement[]
  receipts     RecoveryReceipt[]
}

// Expected recovery (e.g. boring KG) declared on a DC.
model RecoveryRequirement {
  id             String  @id @default(uuid())
  dcId           String
  dc             DeliveryChallan @relation(fields: [dcId], references: [id], onDelete: Cascade)
  recoveryTypeId String
  recoveryType   RecoveryType @relation(fields: [recoveryTypeId], references: [id])
  expectedWeight Decimal @db.Decimal(18, 3)

  @@unique([dcId, recoveryTypeId])
  @@index([dcId])
}

// Actual recovery receipts — multiple lots; history preserved.
model RecoveryReceipt {
  id             String   @id @default(uuid())
  dcId           String
  dc             DeliveryChallan @relation(fields: [dcId], references: [id])
  recoveryTypeId String
  recoveryType   RecoveryType @relation(fields: [recoveryTypeId], references: [id])
  receiptDate    DateTime @default(now())
  receivedBy     String
  weight         Decimal  @db.Decimal(18, 3)
  remarks        String?
  createdAt      DateTime @default(now())

  @@index([dcId])
  @@index([recoveryTypeId])
}

// ============================================================================
// INTERNAL CLASSIFICATION (post-receipt Good / Scrap / Unclassified).
// Unclassified is DERIVED (received - good - scrap), never stored.
// ============================================================================

model MaterialClassification {
  id                String   @id @default(uuid())
  dcId              String
  dc                DeliveryChallan @relation(fields: [dcId], references: [id])
  materialReceiptId String?
  classifiedBy      String
  classifiedAt      DateTime @default(now())

  items MaterialClassificationItem[]

  @@index([dcId])
}

model MaterialClassificationItem {
  id               String  @id @default(uuid())
  classificationId String
  classification   MaterialClassification @relation(fields: [classificationId], references: [id], onDelete: Cascade)
  receivedQty      Decimal @db.Decimal(18, 3)
  goodQty          Decimal @default(0) @db.Decimal(18, 3)
  scrapQty         Decimal @default(0) @db.Decimal(18, 3)
  scrapTypeId      String?
  scrapType        ScrapType? @relation(fields: [scrapTypeId], references: [id])

  @@index([classificationId])
}