# ============================================================================
# DC & Vendor Material Management — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env itself.
# ============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. Prisma reads this directly (prisma/schema.prisma).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dc_material"

# --- Authentication (NextAuth) -----------------------------------------------
# Random secret used to sign session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32+-character-secret"

# Base URL this app is served from. Required by NextAuth in production;
# in local dev NextAuth can usually infer it, but set it explicitly to avoid
# warnings and to make callback URLs deterministic.
NEXTAUTH_URL="http://localhost:3000"

# --- QR codes -----------------------------------------------------------
# Base URL embedded in generated QR codes (spec §21) so scanning from a phone
# on the same network reaches this app. On a single machine this can match
# NEXTAUTH_URL; for phone-scanning during local dev, set this to your
# machine's LAN IP instead (e.g. http://192.168.1.45:3000) — localhost is
# meaningless to any device other than the one running the server.
APP_URL="http://localhost:3000"